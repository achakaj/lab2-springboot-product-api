    {
      "name": "PUT - Modifier le produit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
              "const json = pm.response.json();",
              "pm.test(\"Body: valeurs mises à jour\", function () { pm.expect(json.id).to.eql(parseInt(pm.environment.get(\"productId\"))); pm.expect(json.name).to.eql(\"Ordinateur Portable Pro\"); pm.expect(json.price).to.eql(1300); pm.expect(json.quantity).to.eql(8); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Remplace le produit : 200 avec les nouvelles valeurs.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ordinateur Portable Pro\",\n  \"description\": \"Laptop 15 pouces\",\n  \"price\": 1300,\n  \"quantity\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET - Recherche par nom",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
              "const json = pm.response.json();",
              "pm.test(\"Body: résultats filtrés par nom\", function () { pm.expect(json).to.be.an(\"array\").that.is.not.empty; json.forEach(p => pm.expect(p.name.toLowerCase()).to.include(\"portable\")); });",
              "pm.test(\"Body: contient le produit modifié\", function () { pm.expect(json.map(p => p.id)).to.include(parseInt(pm.environment.get(\"productId\"))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/search?name=portable",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "portable"
            }
          ]
        },
        "description": "Exercice 1 : recherche par nom (contient, insensible à la casse). Placée avant le DELETE pour que le produit existe encore."
      }
    },
