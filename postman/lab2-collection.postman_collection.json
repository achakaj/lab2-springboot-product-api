{
  "info": {
    "name": "Lab 2 - API REST CRUD Spring Boot",
    "description": "Lab 2 : API REST CRUD avec Spring Boot. Démarrer l'application (./mvnw spring-boot:run) avant d'exécuter la collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST - Créer un produit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
              "const json = pm.response.json();",
              "pm.test(\"Body: produit créé avec un id\", function () { pm.expect(json.id).to.be.a(\"number\"); pm.expect(json.name).to.eql(\"Ordinateur Portable\"); pm.expect(json.price).to.eql(1200.5); pm.expect(json.quantity).to.eql(10); });",
              "pm.environment.set(\"productId\", json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Crée un produit. Attendu : 201 Created. L'id généré est stocké dans {{productId}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ordinateur Portable\",\n  \"description\": \"Laptop 15 pouces\",\n  \"price\": 1200.5,\n  \"quantity\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST - Produit invalide (400)",
      "event": [
