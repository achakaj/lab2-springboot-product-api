          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
              "const json = pm.response.json();",
              "pm.test(\"Body: message de validation sur name\", function () { pm.expect(json.name).to.eql(\"Le nom est obligatoire\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Corps sans nom : 400 avec {\"name\": \"Le nom est obligatoire\"}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Sans nom\",\n  \"price\": 10,\n  \"quantity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET - Tous les produits",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
              "const json = pm.response.json();",
              "pm.test(\"Body: tableau contenant le produit créé\", function () { pm.expect(json).to.be.an(\"array\"); pm.expect(json.map(p => p.id)).to.include(parseInt(pm.environment.get(\"productId\"))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Liste de tous les produits : 200."
      }
    },
    {
      "name": "GET - Produit par id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
              "const json = pm.response.json();",
              "pm.test(\"Body: champs du produit\", function () { pm.expect(json.id).to.eql(parseInt(pm.environment.get(\"productId\"))); pm.expect(json).to.include.keys(\"id\", \"name\", \"description\", \"price\", \"quantity\"); pm.expect(json.name).to.eql(\"Ordinateur Portable\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
